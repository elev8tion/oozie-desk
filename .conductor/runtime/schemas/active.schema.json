{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://conductor.local/schemas/active.schema.json","title":"Active Conductor wave","type":"object","required":["schemaVersion","runId","stateRevision","waveId","phase","executions"],"properties":{"schemaVersion":{"const":1},"runId":{"type":"string","minLength":1},"stateRevision":{"type":"integer","minimum":0},"waveId":{"type":"string"},"phase":{"enum":["build","verify","repair"]},"executions":{"type":"array","minItems":1,"items":{"type":"object","required":["section","agent","declaredFiles"],"properties":{"section":{"type":"string"},"agent":{"type":"string"},"piRunId":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"declaredFiles":{"type":"array","items":{"type":"string"},"uniqueItems":true},"token":{"type":"string","pattern":"^[a-f0-9]{64}$"},"authorizationDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},"authorization":{"enum":["revision","snapshot"],"description":"snapshot authorizes each execution by immutable work-order digest and one-time token, so overlapping independent children do not invalidate one another."}},"additionalProperties":false}
