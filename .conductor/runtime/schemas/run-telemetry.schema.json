{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://conductor.local/schemas/run-telemetry.schema.json","title":"Terminal run telemetry","type":"object","required":["schemaVersion","runId","conductorVersion","startedAt","endedAt","wallClockMs","taskSha256","launches","resumes","timeouts","toolHangs","stateWrites","usage","phaseDurationsMs","mechanicalVerdict","reviewVerdict","verdict","unrecoveredFailures"],"properties":{"schemaVersion":{"const":1},"runId":{"type":"string"},"conductorVersion":{"type":"string"},"taskSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"verdict":{"enum":["accepted","rejected","needs-human-review","failed"]},"usageKnown":{"type":"boolean","description":"False when no backend reported token usage; zeros are then not a measurement."},"timing":{"type":"object","additionalProperties":false,"properties":{"coordinatorMs":{"type":"number","minimum":0},"launchMs":{"type":"number","minimum":0},"dependencyWaitMs":{"type":"number","minimum":0},"verificationMs":{"type":"number","minimum":0},"recoveryMs":{"type":"number","minimum":0},"reworkMs":{"type":"number","minimum":0}}},"quality":{"type":"object","additionalProperties":false,"properties":{"firstPassAccepted":{"type":"boolean"},"repairRounds":{"type":"integer","minimum":0},"recoverySucceeded":{"type":"boolean"}}}},"additionalProperties":false}
